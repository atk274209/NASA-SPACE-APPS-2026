{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "am-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "am.main:app", "--port", "8000"],
      "cwd": "backend",
      "env": { "AM_TEST_MODE": "1", "UV_LINK_MODE": "copy" },
      "port": 8000
    },
    {
      "name": "am-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "am-testconsole",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:testconsole"],
      "cwd": "frontend",
      "port": 5174
    }
  ]
}
